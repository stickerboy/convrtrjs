---
title: Flip text
tags: tools
---
{% from "macros/tool.njk" import toolSection with context %}
{% from "macros/tool-frame.njk" import toolFrame %}
{% set filename = page.fileSlug %}
{% set intro %}
<p class="px-2">
    Flip text upside down - allows you to turn <code class="d-inline-flex px-2 bg-success bg-opacity-10 border border-success border-opacity-10 rounded-2">this</code> into <code class="d-inline-flex px-2 bg-success bg-opacity-10 border border-success border-opacity-10 rounded-2">ʇɥıs</code>
</p>
{% endset %}
{% call toolSection(intro) %}
{% call toolFrame(filename, "Flip text", placeholder = "Example: Hello &srarr; Hǝןןo") %}
<button class="btn btn-convrtr" type="button" id="{{ filename }}Run">Flip</button>
<div class="form-check form-switch">
    <input class="form-check-input" type="checkbox" role="switch" id="{{ filename }}Direction">
    <label class="form-check-label" for="{{ filename }}Direction">Reverse</label>
</div>
{% endcall %}
{% endcall %}
