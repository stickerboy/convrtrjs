---
title: Flip text
tags: tools
---
{% from "macros/tool.njk" import toolSection with context %}
{% set filename = page.fileSlug %}
{% set intro %}
<p class="px-2">
    Flip text upside down - allows you to turn <code class="d-inline-flex px-2 bg-success bg-opacity-10 border border-success border-opacity-10 rounded-2">this</code> into <code class="d-inline-flex px-2 bg-success bg-opacity-10 border border-success border-opacity-10 rounded-2">ʇɥıs</code>
</p>
{% endset %}
{% call toolSection(intro) %}
<div class="col">
    <div class="card">
        <span class="card-label visually-hidden">Flip Text</span>
        <div class="card-body text-center">
            <label for="{{ filename }}Text" class="visually-hidden">Flip text upside down</label>
            <textarea placeholder="Example: Hello &srarr; Hǝןןo" rows="6" id="{{ filename }}Text" class="form-control {{ filename }}-text" autocomplete="off"></textarea>
        </div>
        <div class="card-footer py-3">
            <div class="d-flex justify-content-start align-items-center">
                <button type="button" class="btn btn-md btn-convrtr" id="{{ filename }}Decode" title="Flip text upside down">{{ filename | capitalize }}</button>
                <div class="form-check form-switch mx-2">
                    <input class="form-check-input" type="checkbox" role="switch" id="{{ filename }}Direction" aria-checked="false" aria-labelledby="{{ filename }}DirectionLabel">
                    <label class="form-check-label" id="{{ filename }}DirectionLabel" for="{{ filename }}Direction">Reverse</label>
                </div>
                {% include "components/select-copy-dl.njk" %}
            </div>
            <hr />
            <div id="{{ filename }}Results" class="data-to-copy active convrtr-results"></div>
        </div>
    </div>
</div>
{% endcall %}
