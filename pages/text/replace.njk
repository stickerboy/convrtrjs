---
title: Text replace
tags: tools
heading: "Replace characters"
---
{% from "macros/tool.njk" import toolSection with context %}
{% set filename = page.fileSlug %}
{% set intro %}
<p class="px-2">
    Replace characters in a string &ndash; allows replacing any characters or phrases in a string with any character or phrase. 
    Supports <a href="https://en.wikipedia.org/wiki/Regular_expression" class="text-convrtr" title="Regular expression wikipedia page">regex</a> so you can run your own custom advanced replacements.
</p>
{% endset %}
{% call toolSection(intro) %}
<div class="col">
    <div class="card">
        <span class="card-label visually-hidden">Replace characters</span>
        <div class="card-body text-center">
            <label for="{{ filename }}Text" class="visually-hidden">Replace characters in a string</label>
            <textarea placeholder="Example: Hello &srarr; lo &srarr; ium &srarr; Helium" rows="6" id="{{ filename }}Text" class="form-control {{ filename }}-text" autocomplete="off"></textarea>
        </div>
        <div class="card-footer py-3">
            <div class="text-center mb-2 g-0">
                <div class="row row-cols-2 g-md-0 gx-0 gy-2">
                    <div class="col col-12 col-lg-auto me-2 mb-2">
                        <div class="input-group w-auto mb-2">
                            <label class="input-group-text" for="{{ filename }}Value">Old<span class="d-none d-md-block">&nbsp;characters</span></label>
                            <input type="text" class="form-control" id="{{ filename }}Value" autocomplete="off">
                        </div>
                        <div class="input-group w-auto">
                            <label class="input-group-text" id="newCharacters" for="{{ filename }}mentValue">New<span class="d-none d-md-block">&nbsp;characters</span></label>
                            <input type="text" class="form-control" id="{{ filename }}mentValue" autocomplete="off">
                            <button class="btn btn-convrtr" type="button" id="{{ filename }}Decode">Replace</button>
                        </div>
                    </div>
                    <div class="col d-flex flex-fill mb-2">
                        <div class="me-auto flex-fill">
                            <div class="form-check form-switch mx-lg-2 d-flex">
                                <input class="form-check-input" type="checkbox" role="switch" id="{{ filename }}Case" aria-checked="false" aria-labelledby="{{ filename }}CaseLabel">
                                <label class="form-check-label" id="{{ filename }}CaseLabel" for="{{ filename }}Case">Case sensitive</label>
                            </div>
                            <div class="form-check form-switch mx-lg-2 d-flex">
                                <input class="form-check-input" type="checkbox" role="switch" id="{{ filename }}Chain" aria-checked="false" aria-labelledby="{{ filename }}ChainLabel">
                                <label class="form-check-label" id="{{ filename }}ChainLabel" for="{{ filename }}Chain">Chain <span class="visually-hidden" aria-hidden="true" focusable="true">{{ filename }}</span> commands</label>
                            </div>
                        </div>
                        {% include "components/select-copy-dl.njk" %}
                    </div>
                </div>
            </div>
            <hr />
            <div id="{{ filename }}Results" class="data-to-copy active convrtr-results"></div>
        </div>
    </div>
</div>
{% endcall %}
