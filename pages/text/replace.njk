---
title: Text replace
tags: tools
heading: "Replace characters"
summary: >-
    Replaces any characters or phrases in text with others, with <a href="https://en.wikipedia.org/wiki/Regular_expression" class="text-convrtr" title="Regular expression wikipedia page">regex</a> for advanced replacements.
---
{% from "macros/tool.njk" import toolSection with context %}
{% from "macros/tool-frame.njk" import toolFrame %}
{% set filename = page.fileSlug %}
{% call toolSection() %}
{% call toolFrame(filename, "Replace characters", placeholder = "Example: Hello &srarr; lo &srarr; ium &srarr; Helium") %}
<div class="input-group w-auto">
    <label class="input-group-text" for="{{ filename }}Value">Old<span class="visually-hidden"> characters</span></label>
    <input type="text" class="form-control" id="{{ filename }}Value" autocomplete="off" aria-describedby="{{ filename }}Status">
    <label class="input-group-text" for="{{ filename }}mentValue">New<span class="visually-hidden"> characters</span></label>
    <input type="text" class="form-control" id="{{ filename }}mentValue" autocomplete="off" aria-describedby="{{ filename }}Status">
    <button class="btn btn-convrtr" type="button" id="{{ filename }}Run">Replace</button>
</div>
<div class="form-check form-switch">
    <input class="form-check-input" type="checkbox" role="switch" id="{{ filename }}Case">
    <label class="form-check-label" for="{{ filename }}Case">Case sensitive</label>
</div>
{% endcall %}
{% endcall %}
