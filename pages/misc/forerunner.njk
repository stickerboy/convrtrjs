---
title: Forerunner glyphs
tags: tools
---
{% from "macros/tool.njk" import toolSection with context %}
{% set filename = page.fileSlug %}
{% set intro %}
<p class="px-2">
    Convert Forerunner glyphs from the video game <a href="https://www.halowaypoint.com/" title="HaloWaypoint.com - the official site for the Halo universe" class="text-convrtr">Halo</a> to their text alternative, these glyphs were primarily used during an <a href="https://www.halopedia.org/Section_3_ARG" title="Halopedia - Section 3 ARG" class="text-convrtr">ARG</a> for Halo 4. The "Create image" button downloads an image version of the glyphs selected and displayed below the text version.
</p>
<p class="px-2">
     There is more information available on the <a href="https://www.halopedia.org/Forerunner_symbols" class="text-convrtr">Forerunner symbols</a> Halopedia page. 
</p>
{% endset %}
{% call toolSection(intro) %}
<div class="col">
    <div class="card">
        <span class="card-label visually-hidden">Forerunner glyphs</span>
        <div class="card-body text-center" data-pagefind-ignore="all">
            <div class="mb-2">
                {%- for item in forerunner %}
                <button type="button" class="btn btn-outline-convrtr p-0 mb-1 border border-3 border-convrtr rounded-circle fr-glyph" id="fr-{{ item.key }}" aria-label="Glyph: {{ item.key }} [{{ item.glyph }}]" data-bs-toggle="tooltip" data-bs-placement="top" title="Glyph: {{ item.key }} [{{ item.glyph }}]" data-glyph="{{ item.glyph }}">
                    <span class="visually-hidden">Glyph {{ item.key }} [</span>{{ item.glyph }}<span class="visually-hidden">]</span>
                </button>
                {%- endfor %}
            </div>
        </div>
        <div class="card-footer py-3">
            <div class="text-center mb-4 g-0">
                <div class="row row-cols-2 g-sm-0 gx-0 gy-2">
                    <div class="col col-12 col-sm-auto flex-fill">
                        <div class="row row-cols-auto g-1">
                            <div class="input-group w-auto">
                                <button role="button" class="btn btn-md btn-convrtr" id="generateForerunnerImage" title="Create an image from Forerunner glyphs">Create image</button>
                            </div>
                            <div class="form-check form-switch mx-2">
                                <input class="form-check-input" type="checkbox" role="switch" id="frImageTransparency" aria-checked="false" aria-labelledby="frImageTransparencyLabel">
                                <label class="form-check-label" id="frImageTransparencyLabel" for="frImageTransparency">Transparent background <span class="visually-hidden">for Forerunner image</span></label>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-sm-auto">
                        <div class="row row-cols-auto g-0">
                            <div class="col d-flex flex-fill justify-content-end">
                                {% include "components/select-copy-dl.njk" %}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <hr />
            <div id="{{ filename }}Results" class="data-to-copy active convrtr-results h5"></div>
            <div id="{{ filename }}ImageResults" class="forerunner convrtr-results"></div>
        </div>
    </div>
</div>
{% endcall %}
