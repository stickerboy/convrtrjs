---
title: Braille
tags: tools
summary: >-
    Converts Braille to text and back.
---
{% from "macros/tool.njk" import toolSection with context %}
{% from "macros/tool-frame.njk" import toolFrame %}
{% set filename = page.fileSlug %}
{% set intro %}
    <p>"Save as image" downloads the Braille in the output as a picture.</p>
    <p>More on the <a href="https://en.wikipedia.org/wiki/Braille" class="text-convrtr">Braille</a> Wikipedia page.</p>
{% endset %}
{% call toolSection(intro) %}
{% call toolFrame(filename, "Braille", placeholder = "Example: Hello → ⠓⠑⠇⠇⠕", saveImage = true) %}
<div class="btn-group" role="group" aria-label="Convert">
    <button class="btn btn-convrtr" type="button" id="{{ filename }}ToBraille" aria-pressed="true">To Braille</button>
    <button class="btn btn-outline-convrtr" type="button" id="{{ filename }}ToText" aria-pressed="false">To text</button>
</div>
{% endcall %}
{% endcall %}
