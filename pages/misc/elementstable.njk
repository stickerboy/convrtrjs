---
title: Periodic elements table
tags: tools
heading: "Periodic elements"
summary: >-
    An interactive periodic table: choose an element to see its details.
noLimits: true
---
{% from "macros/tool.njk" import toolSection with context %}
{% set filename = page.fileSlug %}
{% set intro %}
    <p>Elements are coloured by category, and the legend highlights one category. Find an element by name, symbol or number, or highlight a phase, block, period or group. On narrower screens, the table becomes a run of tiles in atomic number order.</p>
    <p>More on the <a href="https://en.wikipedia.org/wiki/Periodic_table" class="text-convrtr">Periodic table</a> Wikipedia page.</p>
    <p class="tool-about__credit">Data from <a href="https://github.com/Bowserinator/Periodic-Table-JSON" class="text-convrtr">Bowserinator / Periodic-Table-JSON</a>, under the <a href="https://creativecommons.org/licenses/by-sa/3.0/" class="text-convrtr">Creative Commons Attribution-ShareAlike 3.0 License</a>.</p>
{% endset %}
{% call toolSection(intro) %}
<div class="tool-frame periodic" data-tool-frame>
    <div class="tool-frame__options">
        <div class="input-group w-auto">
            <label class="input-group-text" for="{{ filename }}Search"><i class="bi bi-search" aria-hidden="true"></i><span class="visually-hidden">Find an element</span></label>
            <input type="search" class="form-control" id="{{ filename }}Search" placeholder="Name, symbol or number" autocomplete="off" spellcheck="false" aria-describedby="{{ filename }}Count">
        </div>
        <div class="input-group w-auto">
            <label class="input-group-text" for="{{ filename }}Highlight">Highlight</label>
            <select class="form-select" id="{{ filename }}Highlight" autocomplete="off" aria-describedby="{{ filename }}Count">
                <option value="">Nothing</option>
                <optgroup label="Phase">
                <option value="phase:Solid">Solids</option>
                <option value="phase:Liquid">Liquids</option>
                <option value="phase:Gas">Gases</option>
                </optgroup>
                <optgroup label="Block">
                <option value="block:s">s block</option>
                <option value="block:p">p block</option>
                <option value="block:d">d block</option>
                <option value="block:f">f block</option>
                </optgroup>
                <optgroup label="Period">
                <option value="period:1">Period 1</option>
                <option value="period:2">Period 2</option>
                <option value="period:3">Period 3</option>
                <option value="period:4">Period 4</option>
                <option value="period:5">Period 5</option>
                <option value="period:6">Period 6</option>
                <option value="period:7">Period 7</option>
                </optgroup>
                <optgroup label="Group">
                <option value="group:1">Group 1</option>
                <option value="group:2">Group 2</option>
                <option value="group:3">Group 3</option>
                <option value="group:4">Group 4</option>
                <option value="group:5">Group 5</option>
                <option value="group:6">Group 6</option>
                <option value="group:7">Group 7</option>
                <option value="group:8">Group 8</option>
                <option value="group:9">Group 9</option>
                <option value="group:10">Group 10</option>
                <option value="group:11">Group 11</option>
                <option value="group:12">Group 12</option>
                <option value="group:13">Group 13</option>
                <option value="group:14">Group 14</option>
                <option value="group:15">Group 15</option>
                <option value="group:16">Group 16</option>
                <option value="group:17">Group 17</option>
                <option value="group:18">Group 18</option>
                </optgroup>
            </select>
        </div>
        <span class="tool-pane__status periodic__count" id="{{ filename }}Count" role="status">{{ elements | length }} elements</span>
    </div>
    <div class="tool-frame__stack">
        <div class="periodic-legend" role="group" aria-label="Highlight a category">
    <button type="button" class="periodic-legend__item periodic--alkali" data-category="alkali" aria-pressed="false"><span class="periodic-legend__swatch" aria-hidden="true"></span>Alkali metals</button>
    <button type="button" class="periodic-legend__item periodic--alkaline" data-category="alkaline" aria-pressed="false"><span class="periodic-legend__swatch" aria-hidden="true"></span>Alkaline earth metals</button>
    <button type="button" class="periodic-legend__item periodic--transition" data-category="transition" aria-pressed="false"><span class="periodic-legend__swatch" aria-hidden="true"></span>Transition metals</button>
    <button type="button" class="periodic-legend__item periodic--post-transition" data-category="post-transition" aria-pressed="false"><span class="periodic-legend__swatch" aria-hidden="true"></span>Post-transition metals</button>
    <button type="button" class="periodic-legend__item periodic--metalloid" data-category="metalloid" aria-pressed="false"><span class="periodic-legend__swatch" aria-hidden="true"></span>Metalloids</button>
    <button type="button" class="periodic-legend__item periodic--nonmetal" data-category="nonmetal" aria-pressed="false"><span class="periodic-legend__swatch" aria-hidden="true"></span>Nonmetals</button>
    <button type="button" class="periodic-legend__item periodic--noble" data-category="noble" aria-pressed="false"><span class="periodic-legend__swatch" aria-hidden="true"></span>Noble gases</button>
    <button type="button" class="periodic-legend__item periodic--lanthanide" data-category="lanthanide" aria-pressed="false"><span class="periodic-legend__swatch" aria-hidden="true"></span>Lanthanides</button>
    <button type="button" class="periodic-legend__item periodic--actinide" data-category="actinide" aria-pressed="false"><span class="periodic-legend__swatch" aria-hidden="true"></span>Actinides</button>
        </div>
        {#- The real table when there's room for its 18 groups, otherwise tiles in atomic number order (components/_periodic.scss) #}
        <div class="periodic__scroll">
            <div class="periodic__table" role="group" aria-label="Periodic table">
                {%- for el in elements %}
                <button type="button" class="periodic-element periodic--{{ el.categoryKey }}" style="--x: {{ el.xpos }}; --y: {{ el.ypos }}" aria-pressed="false"
                    data-number="{{ el.number }}" data-name="{{ el.name | lower }}" data-symbol="{{ el.symbol | lower }}"
                    data-phase="{{ el.phase }}" data-block="{{ el.block }}" data-period="{{ el.period }}" data-group="{{ el.group }}" data-category="{{ el.categoryKey }}"
                    aria-label="{{ el.number }} {{ el.name }}">
                    <span class="periodic-element__number" aria-hidden="true">{{ el.number }}</span>
                    <span class="periodic-element__symbol" aria-hidden="true">{{ el.symbol }}</span>
                    <span class="periodic-element__name" aria-hidden="true">{{ el.name }}</span>
                </button>
                {%- endfor %}
                <span class="periodic__gap" style="--x: 3; --y: 6" aria-hidden="true">57–<wbr>71</span>
                <span class="periodic__gap" style="--x: 3; --y: 7" aria-hidden="true">89–<wbr>103</span>
            </div>
        </div>
        <div class="tool-pane" data-download-name="Periodic element">
            <div class="tool-pane__head">
                <span class="tool-pane__label" id="{{ filename }}ResultsLabel">Details</span>
                {% include "components/select-copy-dl.njk" %}
            </div>
            <div id="{{ filename }}Results" class="data-to-copy active" role="region" aria-labelledby="{{ filename }}ResultsLabel" aria-live="polite"></div>
        </div>
    </div>
</div>
{% endcall %}
