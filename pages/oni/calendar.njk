---
title: ONI calendar
tags: tools
heading: "Calendar"
noScript: true
---
{% from "macros/tool.njk" import toolSection with context %}
{% set filename = page.fileSlug %}
{% set intro %}
<p class="px-2">
    Extracts characters from the data string at specific positions based on calendar-like offsets.
</p>
{% endset %}
{% call toolSection(intro) %}
<div class="col">
    <div class="card">
        <span class="card-label visually-hidden">{{ filename | capitalize }}</span>
        <div class="card-body text-left">
            <code class="d-inline-flex px-2 bg-success bg-opacity-10 border border-success border-opacity-10 rounded-2 data-to-copy active">convrtr.{{ filename }}(string)</code>
        </div>
        <div class="card-footer py-3">
            <div class="text-center mb-4 g-0">
                <div class="row row-cols-2 g-md-0 gx-0 gy-2">
                    <div class="col col-12 col-md-auto">
                    </div>
                    <div class="col d-flex flex-fill justify-content-end">
                        {% include "components/select-copy-dl.njk" %}
                    </div>
                </div>
            </div>
            <hr />
            <div class="data-to-copy active convrtr-results"></div>
        </div>
    </div>
</div>
{% endcall %}
