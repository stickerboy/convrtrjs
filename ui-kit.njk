---
title: UI kit
description: The palette, theme tokens and components the site is built from, shown in the light and dark themes side by side. Not linked from the site.
permalink: /ui-kit/
eleventyExcludeFromCollections: true
noindex: true
sidebarPanel: ui-kit
kitGroups: [Foundations, Controls, Tools, Site]
kitSections:
  - { id: palette, title: Palette, group: Foundations }
  - { id: tokens, title: Theme tokens, group: Foundations }
  - { id: typography, title: Typography, group: Foundations }
  - { id: buttons, title: Buttons, group: Controls }
  - { id: forms, title: Forms, group: Controls }
  - { id: tool-frame, title: Tool frame, group: Tools }
  - { id: input-boxes, title: Input boxes, group: Tools }
  - { id: results, title: Results, group: Tools }
  - { id: sidebar-demo, title: Sidebar, group: Site }
  - { id: navigation, title: Navigation, group: Site }
  - { id: tables, title: Tables, group: Site }
  - { id: badges, title: Badges, group: Site }
  - { id: feedback, title: Feedback, group: Site }
---
{#
    Every demo is a macro taking the pane's theme ("light" or "dark") so ids stay unique,
    and panes() renders it once in each theme. Use real site classes only, so the kit
    shows what the site actually renders.
#}
{#- wide: the two themes one above the other at every width, for a demo that needs the room, such as the tool frame #}
{% macro panes(demo, wide = false) %}
<div class="row g-3">
    {%- for theme in ["light", "dark"] %}
    <div class="col-12{% if not wide %} col-xxl-6{% endif %}">
        <div class="ui-kit-pane" data-bs-theme="{{ theme }}">
            <p class="ui-kit-pane__label">{{ theme | capitalize }}</p>
            {{ demo(theme) }}
        </div>
    </div>
    {%- endfor %}
</div>
{% endmacro %}

{% macro kitSection(id, heading, description) %}
<section id="{{ id }}" class="section">
    <div class="py-4 px-2 px-sm-4">
        <h2 class="display-6">{{ heading }}</h2>
        <p class="px-2 text-body-secondary">{{ description }}</p>
        {{ caller() }}
    </div>
</section>
{% endmacro %}

{#- Palette -#}
{% macro swatch(label, cls, style) %}
<div class="ui-kit-swatch">
    <div class="ui-kit-swatch__chip {{ cls }}" data-swatch{% if style %} style="background-color: {{ style }}"{% endif %}></div>
    <div class="ui-kit-swatch__name">{{ label }}</div>
    <code class="ui-kit-swatch__value small"></code>
</div>
{% endmacro %}

{% macro tokens(t) %}
<h3 class="h6">Site tokens</h3>
<div class="ui-kit-swatches mb-4">
    {{ swatch("--convrtr-surface", "", "var(--convrtr-surface)") }}
    {{ swatch("--convrtr-surface-alt", "", "var(--convrtr-surface-alt)") }}
    {{ swatch("--convrtr-accent", "", "var(--convrtr-accent)") }}
    {{ swatch("--convrtr-accent-subtle", "", "var(--convrtr-accent-subtle)") }}
    {{ swatch("--convrtr-accent-subtle-hover", "", "var(--convrtr-accent-subtle-hover)") }}
    {{ swatch("--convrtr-accent-selected", "", "var(--convrtr-accent-selected)") }}
    {{ swatch("--convrtr-row-highlight", "", "var(--convrtr-row-highlight)") }}
</div>
<h3 class="h6">Bootstrap theme</h3>
<div class="ui-kit-swatches mb-4">
    {{ swatch("--bs-body-bg", "", "var(--bs-body-bg)") }}
    {{ swatch("--bs-body-color", "", "var(--bs-body-color)") }}
    {{ swatch("--bs-secondary-color", "", "var(--bs-secondary-color)") }}
    {{ swatch("--bs-border-color", "", "var(--bs-border-color)") }}
    {{ swatch("--bs-link-color", "", "var(--bs-link-color)") }}
    {{ swatch("--bs-primary", "", "var(--bs-primary)") }}
    {{ swatch("--bs-primary-text-emphasis", "", "var(--bs-primary-text-emphasis)") }}
    {{ swatch("--bs-primary-bg-subtle", "", "var(--bs-primary-bg-subtle)") }}
    {{ swatch("--bs-primary-border-subtle", "", "var(--bs-primary-border-subtle)") }}
</div>
<h3 class="h6">Contrast</h3>
<p class="small text-body-secondary">Text needs 4.5:1 (AA). 3:1 is enough for large text, icons and borders.</p>
<div class="table-responsive">
    <table class="table table-sm align-middle ui-kit-contrast mb-0">
        <thead>
            <tr><th scope="col">Sample</th><th scope="col">Foreground</th><th scope="col">Background</th><th scope="col" class="text-end">Ratio</th></tr>
        </thead>
        <tbody>
            {%- for pair in [
                ["--bs-body-color", "--convrtr-surface"],
                ["--bs-body-color", "--convrtr-surface-alt"],
                ["--bs-secondary-color", "--convrtr-surface"],
                ["--bs-link-color", "--convrtr-surface"],
                ["--bs-link-color", "--convrtr-surface-alt"],
                ["--bs-convrtr-text-emphasis", "--convrtr-surface"],
                ["--convrtr-accent", "--convrtr-surface"],
                ["--convrtr-accent", "--convrtr-surface-alt"],
                ["--convrtr-accent", "--convrtr-accent-subtle"],
                ["--bs-body-color", "--convrtr-accent-subtle"],
                ["--convrtr-accent", "--convrtr-accent-selected"],
                ["--bs-body-color", "--bs-primary-bg-subtle"],
                ["--bs-white", "--bs-primary"]
            ] %}
            <tr data-fg="{{ pair[0] }}" data-bg="{{ pair[1] }}">
                <td><span class="ui-kit-contrast__sample" style="color: var({{ pair[0] }}); background-color: var({{ pair[1] }})">Aa</span></td>
                <td><code class="small">{{ pair[0] }}</code></td>
                <td><code class="small">{{ pair[1] }}</code></td>
                <td class="text-end text-nowrap"><span class="ui-kit-contrast__ratio"></span></td>
            </tr>
            {%- endfor %}
        </tbody>
    </table>
</div>
{% endmacro %}

{#- Typography -#}
{% macro typography(t) %}
<h1 class="display-6">Display 6, page and tool headings</h1>
<h2>Heading 2</h2>
<h3>Heading 3</h3>
<h4>Heading 4</h4>
<h5>Heading 5</h5>
<h6>Heading 6</h6>
<p class="lead">Lead paragraph, used for short introductions.</p>
<p>
    Body text with <a href="#{{ t }}-typography">a link</a>, <a href="#{{ t }}-typography" class="text-convrtr">a .text-convrtr link</a>,
    <strong>bold</strong>, <em>emphasis</em>, <mark>marked text</mark>, inline <code>code</code> and a tool example,
    <code class="tool-example">48 65 6c 6c 6f</code>, as in a tool's info text.
</p>
<p class="text-body-secondary mb-2">Secondary text, for descriptions and hints.</p>
<p class="small mb-0">Small text.</p>
{% endmacro %}

{#- Buttons -#}
{% macro buttons(t) %}
<div class="d-flex flex-wrap gap-2 mb-3">
    <button type="button" class="btn btn-convrtr">Primary action</button>
    <button type="button" class="btn btn-outline-convrtr">Secondary action</button>
    <button type="button" class="btn btn-convrtr" disabled>Disabled</button>
    <button type="button" class="btn btn-outline-convrtr" disabled>Disabled</button>
</div>
<div class="d-flex flex-wrap gap-2 mb-3">
    <button type="button" class="btn btn-md btn-light">Light</button>
    <button type="button" class="btn btn-md btn-danger">Danger</button>
    <button type="button" class="btn btn-link">Link button</button>
    <button type="button" class="btn btn-reset-data btn-outline-danger"><i class="bi bi-arrow-counterclockwise me-2"></i>Reset</button>
</div>
<p class="small text-body-secondary mb-2">Select, copy and download group:</p>
<div class="d-flex">
    {% include "components/select-copy-dl.njk" %}
</div>
{% endmacro %}

{#- Forms: a tool's settings, as tool fields with their label above (scss/components/_tool-frame.scss) -#}
{% from "macros/delimiter.njk" import delimiter %}
{% macro forms(t) %}
<div class="d-flex flex-wrap gap-3 align-items-end mb-4">
    <div class="tool-field">
        <label class="tool-field__label" for="{{ t }}-key">Key</label>
        <input type="text" class="form-control" id="{{ t }}-key" placeholder="Optional" autocomplete="off">
    </div>
    <div class="tool-field">
        <div class="tool-field__head">
            <label class="tool-field__label" for="{{ t }}-new">New</label>
            <span class="tool-field__note" id="{{ t }}-new-note">Leave empty to remove</span>
        </div>
        <input type="text" class="form-control" id="{{ t }}-new" autocomplete="off" aria-describedby="{{ t }}-new-note">
    </div>
    <div class="tool-field tool-field--short">
        <label class="tool-field__label" for="{{ t }}-rails">Rails</label>
        <input type="number" class="form-control" id="{{ t }}-rails" min="2" value="3" autocomplete="off">
    </div>
</div>
<p class="small text-body-secondary mb-2">A stepper, as Caesar's shift, and two dropdowns with Swap between them, as the Elements converter:</p>
<div class="d-flex flex-wrap gap-3 align-items-end mb-4">
    <div class="tool-field">
        <label class="tool-field__label" for="{{ t }}-shift">Shift</label>
        <div class="input-group tool-stepper">
            <button class="btn btn-outline-convrtr btn-icon-text" type="button" aria-label="Previous shift"><i class="bi bi-chevron-left" aria-hidden="true"></i></button>
            <input type="number" class="form-control" id="{{ t }}-shift" min="1" max="25" value="3" autocomplete="off">
            <button class="btn btn-outline-convrtr btn-icon-text" type="button" aria-label="Next shift"><i class="bi bi-chevron-right" aria-hidden="true"></i></button>
        </div>
    </div>
    <div class="tool-field">
        <label class="tool-field__label" for="{{ t }}-from">From</label>
        <select class="form-select" id="{{ t }}-from"><option>Atomic number</option><option>Element symbol</option></select>
    </div>
    <button type="button" class="btn btn-outline-convrtr tool-swap" aria-label="Swap from and to" title="Swap from and to"><i class="bi bi-arrow-left-right" aria-hidden="true"></i></button>
    <div class="tool-field">
        <label class="tool-field__label" for="{{ t }}-to">To</label>
        <select class="form-select" id="{{ t }}-to"><option>Element symbol</option><option>Atomic number</option></select>
    </div>
    <div class="tool-field">
        <label class="tool-field__label" for="{{ t }}Delimiter">Delimiter</label>
        {{ delimiter(t) }}
    </div>
</div>
<p class="small text-body-secondary mb-2">A problem: the box that needs fixing is outlined, and the status line under it says what's wrong.</p>
<div class="tool-pane mb-4">
    <textarea class="form-control tool-pane__box is-invalid" rows="2" aria-label="Input with a problem" aria-describedby="{{ t }}-problem"></textarea>
    <div class="tool-pane__status"><span id="{{ t }}-problem" class="text-danger">There's no text to convert</span><span>0 characters</span></div>
</div>
<p class="small text-body-secondary mb-2">A label joined to its box, an older pattern still on Hash's "Check a hash" and the File headers search:</p>
<div class="input-group mb-4">
    <label class="input-group-text" for="{{ t }}-check-hash">Check a hash</label>
    <input type="text" class="form-control font-monospace" id="{{ t }}-check-hash" placeholder="Paste a hash to find its algorithm" autocomplete="off">
</div>
<div class="d-flex flex-wrap gap-4">
        <div class="form-check form-switch">
            <input class="form-check-input" type="checkbox" role="switch" id="{{ t }}-switch" checked>
            <label class="form-check-label" for="{{ t }}-switch">Switch</label>
        </div>
        <div class="form-check">
            <input class="form-check-input" type="checkbox" id="{{ t }}-check" checked>
            <label class="form-check-label" for="{{ t }}-check">Checkbox</label>
        </div>
        <div class="form-check">
            <input class="form-check-input" type="radio" name="{{ t }}-radio" id="{{ t }}-radio1" checked>
            <label class="form-check-label" for="{{ t }}-radio1">Radio</label>
        </div>
        <div class="form-check">
            <input class="form-check-input" type="radio" name="{{ t }}-radio" id="{{ t }}-radio2">
            <label class="form-check-label" for="{{ t }}-radio2">Radio</label>
        </div>
</div>
{% endmacro %}

{#- Tool frame: the real macro, wired up by ui-kit.js with the real tool-frame.js, so it behaves as a tool does -#}
{% from "macros/tool-frame.njk" import toolFrame %}
{% macro toolFrames(t) %}
<h3 class="h6">Input and result, with a field and two actions</h3>
<p class="small text-body-secondary">The result's header says what made it. Settings and actions sit in a column beside the input once the frame is wide enough, and stack above and below it when it isn't.</p>
{% call toolFrame("kit" ~ t ~ "Rail", "Rail fence cipher", placeholder = "Example: HELLO WORLD", actions = [{ id: "kit" ~ t ~ "RailEncrypt", label: "Encrypt" }, { id: "kit" ~ t ~ "RailDecrypt", label: "Decrypt" }]) %}
<div class="tool-field tool-field--short">
    <label class="tool-field__label" for="kit{{ t }}RailAmount">Rails</label>
    <input type="number" class="form-control" id="kit{{ t }}RailAmount" min="2" value="3" autocomplete="off">
</div>
{% endcall %}
<h3 class="h6 mt-4">Output tabs</h3>
<p class="small text-body-secondary">One result in several formats, as Hex shift gives it. Move to input takes the tab the tool says, whichever is showing.</p>
{% call toolFrame("kit" ~ t ~ "Bytes", "Text to bytes", placeholder = "Example: Hello", tabs = ["Hex", "Binary", "Decimal", "Base64"], actions = [{ id: "kit" ~ t ~ "BytesRun", label: "Convert" }]) %}{% endcall %}
<h3 class="h6 mt-4">List of results</h3>
<p class="small text-body-secondary">Several results at once, as Hash algorithms gives them: in groups, each row with its own copy button. The options sit in a bar above the input.</p>
{% call toolFrame("kit" ~ t ~ "List", "Formats", placeholder = "Example: Hi", layout = "list", listLabel = "Formats") %}
<button class="btn btn-convrtr" type="button" id="kit{{ t }}ListRun">Generate</button>
{% endcall %}
{% endmacro %}

{#- Results: folds, and the figures and sortable tables the frequency tools draw (ui/frequencies.js, filled by ui-kit.js) -#}
{% macro results(t) %}
<h3 class="h6">Folds</h3>
<p class="small text-body-secondary">A group of results that opens and closes, with what's in it on the right, as in the Exif reader.</p>
<div class="mb-4">
    <details class="tool-fold" open>
        <summary><i class="bi bi-chevron-right tool-fold__chevron" aria-hidden="true"></i>Camera<small>4 tags</small></summary>
        <div class="p-3">Make: Apple · Model: iPhone 13 · Exposure: 1/120 s · f/1.6</div>
    </details>
    <details class="tool-fold">
        <summary><i class="bi bi-chevron-right tool-fold__chevron" aria-hidden="true"></i>Location<small>3 tags</small></summary>
        <div class="p-3">55.8642, -4.2518 · 38 m</div>
    </details>
</div>
<h3 class="h6">Figures and tables</h3>
<p class="small text-body-secondary">What the frequency tools show: figures first, then tables that sort by any column. With more than one table, each is in a fold.</p>
<div class="tool-pane__analysis" id="kit{{ t }}Frequencies" data-kit-frequencies></div>
{% endmacro %}

{#- Navigation -#}
{% macro navigation(t) %}
<nav aria-label="Breadcrumb example">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="#{{ t }}-navigation" class="text-convrtr">home</a></li>
        <li class="breadcrumb-item"><a href="#{{ t }}-navigation" class="text-convrtr">ciphers</a></li>
        <li class="breadcrumb-item active" aria-current="page">caesar</li>
    </ol>
</nav>
<ul class="pagination flex-wrap">
    <li class="page-item"><button type="button" class="page-link" aria-label="Previous">&laquo;</button></li>
    <li class="page-item"><button type="button" class="page-link">a</button></li>
    <li class="page-item active"><button type="button" class="page-link" aria-current="true">b</button></li>
    <li class="page-item"><button type="button" class="page-link">c</button></li>
    <li class="page-item disabled"><button type="button" class="page-link" disabled>d</button></li>
    <li class="page-item"><button type="button" class="page-link" aria-label="Next">&raquo;</button></li>
</ul>
<div class="list-group">
    <a href="#{{ t }}-navigation" class="list-group-item list-group-item-action active" aria-current="true">Active list item</a>
    <a href="#{{ t }}-navigation" class="list-group-item list-group-item-action">List item</a>
    <a href="#{{ t }}-navigation" class="list-group-item list-group-item-action disabled" aria-disabled="true">Disabled list item</a>
</div>
{% endmacro %}

{#- Input boxes: a set with Swap (as Interleave), and a list boxes can be added to and removed from (as Merge Base64) -#}
{% from "macros/tool-frame.njk" import inputBox %}
{% macro inputBoxes(t) %}
<div class="row g-4">
    <div class="col-12 col-md-6">
        <div class="tool-pane">
            <div class="tool-inputs" role="group" aria-label="A set of two boxes" data-input-list>
                {{ inputBox("kit" ~ t ~ "Pair", 1, "First", "Example: HLOWRD") }}
                <button type="button" class="btn btn-outline-convrtr btn-icon-text tool-inputs__swap" data-input-swap aria-label="Swap first and second"><i class="bi bi-arrow-down-up" aria-hidden="true"></i>Swap</button>
                {{ inputBox("kit" ~ t ~ "Pair", 2, "Second", "Example: EL OL") }}
            </div>
            <div class="tool-pane__status"><span id="kit{{ t }}PairInputStatus" role="status"></span></div>
        </div>
    </div>
    <div class="col-12 col-md-6">
        <div class="tool-pane">
            <div class="tool-inputs" role="group" aria-label="A list of boxes" data-input-list data-label="String" data-min="2" data-max="4">
                {{ inputBox("kit" ~ t ~ "List", 1, "String 1", "", removable = true) }}
                {{ inputBox("kit" ~ t ~ "List", 2, "String 2", "", removable = true) }}
            </div>
            <button type="button" class="btn btn-outline-convrtr btn-icon-text tool-inputs__add" data-input-add><i class="bi bi-plus-lg" aria-hidden="true"></i>Add a string</button>
            <div class="tool-pane__status"><span id="kit{{ t }}ListInputStatus" role="status"></span></div>
        </div>
    </div>
</div>
{% endmacro %}

{#- Sidebar -#}
{% from "macros/sidebar.njk" import sidebar %}
{% macro sidebarDemo(t) %}
<div class="d-flex flex-wrap gap-3">
    <div class="ui-kit-sidebar">{{ sidebar(nav, "/ciphers/caesar/", "kit-" ~ t ~ "-open") }}</div>
    <div class="ui-kit-sidebar">{{ sidebar(nav, "/ciphers/caesar/", "kit-" ~ t ~ "-closed", "") }}</div>
</div>
{% endmacro %}

{#- Tables -#}
{% macro tables(t) %}
<div class="table-responsive">
    <table class="table table-striped mb-0">
        <thead class="table-convrtr">
            <tr><th scope="col">Key</th><th scope="col">Value</th></tr>
        </thead>
        <tbody>
            <tr><td>theme</td><td>dark</td></tr>
            <tr><td>toolsLive</td><td>on</td></tr>
            <tr><td>hexDelimiter</td><td>space</td></tr>
        </tbody>
    </table>
</div>
{% endmacro %}

{#- Feedback -#}
{% macro feedback(t) %}
<div class="toast show mb-4" role="status" aria-live="off">
    <div class="toast-header text-bg-convrtr">
        <strong class="me-auto">Copied</strong>
        <button type="button" class="btn-close" aria-label="Close"></button>
    </div>
    <div class="toast-body">The results have been copied to your clipboard.</div>
</div>
<div class="alert alert-info mb-0" role="note">Info alert, as the privacy notice uses when nothing is stored.</div>
{% endmacro %}

{#- The sections as a row of links, for when the sidebar panel that lists them isn't showing (layout/_sections.scss) #}
<nav class="section-nav mt-0 px-3 px-sm-4" aria-label="UI kit sections">
    {%- for section in kitSections %}
    <a class="sidebar-panel__link" href="#{{ section.id }}" data-section-link="{{ section.id }}">{{ section.title }}</a>
    {%- endfor %}
</nav>

{% call kitSection("palette", "Palette", "The brand teal, built with Bootstrap's tint-color and shade-color, and the neutrals used for surfaces. These are Sass variables, so they look the same in either theme.") %}
<div class="ui-kit-swatches mb-4">
    {%- for step in [100, 200, 300, 400, 500, 600, 700, 800, 900] %}
    {{ swatch("$convrtr-" ~ step, "ui-kit-swatch--convrtr-" ~ step) }}
    {%- endfor %}
</div>
<div class="ui-kit-swatches">
    {{ swatch("$white", "ui-kit-swatch--white") }}
    {{ swatch("$gray-100", "ui-kit-swatch--gray-100") }}
    {{ swatch("$gray-300", "ui-kit-swatch--gray-300") }}
    {{ swatch("$gray-900", "ui-kit-swatch--gray-900") }}
    {{ swatch("$dark-surface", "ui-kit-swatch--dark-surface") }}
    {{ swatch("$dark-surface-raised", "ui-kit-swatch--dark-surface-raised") }}
</div>
{% endcall %}

{% call kitSection("tokens", "Theme tokens", "The roles components use. Each switches value with the theme, so use these rather than palette colours.") %}
{{ panes(tokens) }}
{% endcall %}

{% call kitSection("typography", "Typography", "Headings, body text and inline elements.") %}
{{ panes(typography) }}
{% endcall %}

{% call kitSection("buttons", "Buttons", "Primary and secondary actions, utility buttons and the results toolbar.") %}
{{ panes(buttons) }}
{% endcall %}

{% call kitSection("forms", "Forms", "A tool's settings: fields with their label above, sometimes with a note on the right, a short field for a number, a stepper, dropdowns with Swap, switches and checks, and how a problem shows.") %}
{{ panes(forms) }}
{% endcall %}

{% call kitSection("tool-frame", "Tool frame", "What every text tool sits in (macros/tool-frame.njk), in its three layouts. These work: type, press the buttons, try Live typing and Move to input.") %}
{{ panes(toolFrames, wide = true) }}
{% endcall %}

{% call kitSection("input-boxes", "Input boxes", "For a tool that takes more than one text: a set of boxes with Swap between them, as on Interleave, or a list that boxes can be added to and removed from, as on Merge Base64. Each box has its own label and count. The tool frame builds them from its inputs and inputList options, and ui/input-list.js runs them.") %}
{{ panes(inputBoxes) }}
{% endcall %}

{% call kitSection("results", "Results", "What tools show besides a plain result: folds, and the figures and sortable tables of the frequency tools.") %}
{{ panes(results) }}
{% endcall %}

{% call kitSection("sidebar-demo", "Sidebar", "The category rail and the panel of tools, as on a Caesar cipher page. With the panel open it shows the current category; with it closed, the bar on the rail marks the current category.") %}
{{ panes(sidebarDemo) }}
{% endcall %}

{% call kitSection("navigation", "Navigation", "Breadcrumbs, the changelog's pagination, and the list groups on the search and sitemap pages.") %}
{{ panes(navigation) }}
{% endcall %}

{% call kitSection("tables", "Tables", "A plain data table, as the privacy notice lists what's stored.") %}
{{ panes(tables) }}
{% endcall %}

{% set badgeHtml %}
<div class="badges flex-wrap">
    {%- for label in labels.labels %}
    <span class="badge git-badge badge-{{ label.key }}">{{ label.key }}</span>
    {%- endfor %}
</div>
<div class="badges flex-wrap mt-3">
    {%- for tag in ["tools", "landing-page", "changelog", "community", "misc"] %}
    <span class="badge badge-{{ tag }}">{{ tag }}</span>
    {%- endfor %}
    <span class="badge text-bg-convrtr">12 results</span>
</div>
{% endset %}
{% macro badges(t) %}{{ badgeHtml }}{% endmacro %}
{% call kitSection("badges", "Badges", "Changelog labels, search result tags and counts.") %}
{{ panes(badges) }}
{% endcall %}

{% call kitSection("feedback", "Feedback", "Toasts and alerts.") %}
{{ panes(feedback) }}
{% endcall %}

<script type="module" src="/assets/js/site/ui-kit.js"></script>
