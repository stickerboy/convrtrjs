<!doctype html>
<html lang="en" class="overflow-y-hidden">
    <head>
        {% include "partials/ga.njk" %}
        {% include "partials/cookie.njk" %}
        {% include "partials/meta.njk" %}
        {% include "partials/title.njk" %}

        <script>
            (function () {
                const theme = localStorage.getItem("theme") || "auto";
                document.documentElement.setAttribute("data-bs-theme", theme);
            })();
        </script>

        {% include "partials/css.njk" %}
        {% include "partials/favicons.njk" %}
    </head>
    <body>
        <a class="visually-hidden-focusable position-absolute" href="#content">Skip to main content</a>
        {% include "partials/header.njk" %}
        {%- if pageId != "search" -%}
        {% include "partials/search.njk" %}
        {%- endif -%}
        <div class="mw d-flex mx-auto">
            <div class="grid sidebar-grid gap-0 p-0 w-100">
                <div class="nav-bar p-0 position-fixed overflow-y-auto overflow-x-hidden">
                    {% include "partials/sidebar.njk" %}
                </div>
                {% set isExcluded = pageId in ["404", "search", "sitemap", "tags"] %}
                {% set isTagPath = "tag" in page.inputPath %}
                {%- for tag in tags -%}
                <span class="hidden" data-pagefind-filter="Filters">{{ tag }}</span>
                {%- endfor -%}
                {%- for tag in tags -%}<span class="hidden" data-pagefind-meta="{{tag}}:" data-pagefind-ui-meta="{{tag}}"></span>{%- endfor -%}
                <main class="page-wrap page-wrap-{{ pageId }} overflow-y-auto p-0 mw{% if pageId == "404" %} g-start-1 g-start-md-2{% endif %}"
                    data-bs-smooth-scroll="true" id="content"{% if not (isExcluded or isTagPath) %} data-pagefind-body{% endif %}>
                    {% if pageId != "404" -%}
                    {% include "partials/page-header.njk" %}
                    {%- endif -%}
                    {{ content }}
                    {% include "partials/footer.njk" %}
                </main>
            </div>
        </div>
        {% include "partials/scripts.njk" %}
        {% include "partials/toast.njk" %}
    </body>
</html>
{% set routePartial = "partials/routes/" ~ pageId ~ ".njk" %}
{% if routePartial | fileExists %}
    {% include routePartial %}
{% else %}
    {% include "partials/routes/home.njk" %}
{% endif %}
