<!doctype html>
<html lang="en" class="overflow-y-hidden">
    <head>
        {#- meta first: the charset has to be in the first 1024 bytes #}
        {% include "partials/meta.njk" %}
        {% include "partials/ga.njk" %}
        {% include "partials/cookie.njk" %}
        {#- Lets modules import npm packages by name (copied to /assets/js/vendor/ - see eleventy.config.js). Must come before any module script. #}
        <script type="importmap">{ "imports": { "@noble/hashes/": "/assets/js/vendor/noble-hashes/" } }</script>
        {% include "partials/title.njk" %}

        {#- Runs before the page is drawn, so it starts in the saved theme, sidebar state and display settings rather than
            flashing the defaults. All are saved by ui/storage.js as { value, ... }; theme.js takes over the theme once the
            page has loaded, and site/preferences.js the display settings (it sets the same attributes). #}
        <script>
            (function () {
                const root = document.documentElement;
                const saved = (key) => {
                    try {
                        return JSON.parse(localStorage.getItem(key))?.value;
                    } catch {
                        return undefined;
                    }
                };
                // Bootstrap only knows light and dark, so auto (or nothing saved) follows the system
                const theme = saved("theme");
                root.setAttribute("data-bs-theme", theme === "light" || theme === "dark" ? theme
                    : matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
                // The sidebar panel was left closed; see layout/_sidebar.scss
                if (saved("sidebarPanel") === "closed") {
                    root.setAttribute("data-sidebar-panel", "closed");
                }
                // Display settings; see base/_preferences.scss
                for (const [key, attribute] of [["reduceMotion", "data-reduce-motion"], ["compactLayout", "data-compact"], ["monoBoxes", "data-mono-boxes"]]) {
                    if (saved(key) === "on") {
                        root.setAttribute(attribute, "");
                    }
                }
                const boxSize = saved("boxTextSize");
                if (boxSize === "small" || boxSize === "large") {
                    root.setAttribute("data-box-size", boxSize);
                }
            })();
        </script>

        {% include "partials/css.njk" %}
        {% include "partials/favicons.njk" %}
    </head>
    <body>
        <a class="visually-hidden-focusable position-absolute" href="#content">Skip to main content</a>
        {% include "partials/header.njk" %}
        {% include "partials/switcher.njk" %}
        <div class="mw d-flex mx-auto">
            <div class="grid sidebar-grid gap-0 p-0 w-100">
                <div class="nav-bar">
                    {%- from "macros/sidebar.njk" import sidebar %}
                    {#- sidebarPanel in front matter: "closed" starts the panel closed on that page, whatever was saved; any
                        other value is the page's own panel content, from partials/panels/<value>.njk #}
                    {%- set panelClosed = sidebarPanel == "closed" %}
                    {%- set pagePanel %}{% if sidebarPanel and not panelClosed %}{% include "partials/panels/" ~ sidebarPanel ~ ".njk" %}{% endif %}{% endset %}
                    {{ sidebar(nav, page.url, expanded = ("" if panelClosed else null), remember = not panelClosed, pagePanel = (pagePanel if sidebarPanel and not panelClosed else "")) }}
                </div>
                {#- Not indexed for search: utility pages, and the changelog lists, which only repeat what each version's page says #}
                {% set isExcluded = pageId in ["404", "search", "sitemap", "tags", "ui-kit", "changelog"] %}
                {% set isTagPath = "tag" in page.inputPath %}
                {#- Search filters, which the search page shows in its panel: the section a page belongs to, and a changelog
                    entry's labels under their group (_data/labels.json) #}
                {%- if pageId == "changelog-item" %}<span class="hidden" data-pagefind-filter="Section">changelog</span>{% endif -%}
                {%- for tag in tags -%}
                {%- set label = labels.labels | where("key", tag) | first -%}
                {%- if label %}<span class="hidden" data-pagefind-filter="{{ label.group }}">{{ tag }}</span>
                {%- elif labels.sections | where("key", tag) | length %}<span class="hidden" data-pagefind-filter="Section">{{ tag }}</span>
                {%- endif -%}
                {%- endfor -%}
                {%- for tag in tags -%}<span class="hidden" data-pagefind-meta="{{tag}}:" data-pagefind-ui-meta="{{tag}}"></span>{%- endfor -%}
                <main class="page-wrap page-wrap-{{ pageId }}{% if tags and "landing-page" in tags %} landing-page{% endif %} overflow-y-auto p-0 mw"
                    data-bs-smooth-scroll="true" id="content"{% if not (isExcluded or isTagPath) %} data-pagefind-body{% endif %}>
                    {% if pageId != "404" -%}
                    {% include "partials/page-header.njk" %}
                    {%- endif -%}
                    {{ content }}
                    {% include "partials/footer.njk" %}
                </main>
            </div>
        </div>
        {% include "partials/scripts.njk" %}
        {% include "partials/toast.njk" %}
    </body>
</html>
{# Hidden packet for this page (partials/routes/<pageId>.njk), falling back to the home packet #}
{% set packet %}{% include "partials/routes/" ~ pageId ~ ".njk" ignore missing %}{% endset %}
{% if packet | trim %}
    {{ packet }}
{% else %}
    {% include "partials/routes/home.njk" %}
{% endif %}
