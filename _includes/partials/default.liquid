<section class="section" id="IOOBI9O4IEIEOIO4O4IB">
    <div class="py-3 pb-4 px-2 px-sm-4">
        {% include "layout/breadcrumbs" %}
        <div class="section-heading">
            {% assign currentTag = tagPage.tag %}
            {% if currentTag == blank and page.url contains "/changelog/tag/" %}
            {% assign tagPath = page.url | remove_first: "/changelog/tag/" | split: "/" %}
            {% assign currentTag = tagPath[0] %}
            {% endif %}
            {% assign normalizedCurrentTag = currentTag | downcase | strip %}
            {% assign currentTagLabel = labels.labels | where: "key", normalizedCurrentTag | first %}
            <h1 class="display-6">{%- if page.inputPath contains "changelog" and page.templateSyntax contains "liquid,md" -%}<span class="visually-hidden" data-pagefind-ignore>Changelog | </span>v{% endif %}{{ title }}{% if currentTag %} <span class="h5"><span class="badge git-badge badge-{% if currentTagLabel %}{{ currentTagLabel.key }}{% else %}{{ currentTag }}{% endif %}">{% if currentTagLabel %}{{ currentTagLabel.key }}{% else %}{{ currentTag }}{% endif %}</span></span>{% if tagPage.pagination.pageNumber > 0 %}<small class="text-body-secondary fs-3"> | Page {{ tagPage.pagination.pageNumber | plus: 1 }}</small>{% endif %}{% endif %}{% if page.inputPath contains "changelog" %}<small class="text-body-secondary fs-3">{{ changelog-title }}</small>{% endif %}</h1>
            <hr>
            <p class="px-2"{%- if page.inputPath contains "changelog" -%} data-pagefind-ignore="all"{%- endif -%}>
                {{ description }}
            </p>
            {%- if tags %}
            <div class="px-2">
                {%- for tag in tags -%}
                {% assign normalizedTag = tag | downcase -%}
                {% assign label = labels.labels | where: "key", normalizedTag | first -%}
                {% if label %}
                <a href="{{ '/changelog/tag/' | append: tag | url }}" class="badge git-badge badge-{{ label.key }}" title="{{ label.description }}">{{ label.key }}</a>
                {%- endif -%}
                {%- endfor %}
            </div>
            {%- endif -%}
            {%- assign excluded_ids = "files,check,exif,headers,community,privacy,about,accessibility,license,contributing,code-of-conduct,security,sitemap,search,settings" | split: "," -%}
            {%- assign excluded_fragments = "tag,tags,changelog" | split: "," -%}

            {%- assign id_excluded = excluded_ids contains page-id -%}
            {%- assign path_excluded = false -%}

            {%- for fragment in excluded_fragments -%}
            {%- if page.inputPath contains fragment -%}
                {%- assign path_excluded = true -%}
            {%- endif %}
            {%- endfor -%}

            {%- if id_excluded or path_excluded -%}
                {%- comment -%} Do nothing {%- endcomment -%}
            {%- else -%}
                {% render "components/data-limits" %}
            {%- endif %}
        </div>
    </div>
</section>