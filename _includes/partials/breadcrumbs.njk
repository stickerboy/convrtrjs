{% if page.url != "/" %}
<nav aria-label="breadcrumb">
    <ol class="breadcrumb justify-content-end mb-0">
        <li class="breadcrumb-item">
            {% if page.url == "/" %}
            Home
            {% else %}
            <a href="{{ '/' | url }}" class="text-convrtr">
                <i class="bi bi-house-fill me-1" aria-hidden="true" focusable="false"></i>Home
            </a>
            {% endif %}
        </li>
        {% if folderName and folderName != "pages" %}
        {% if folderName != "text" %}
        <li class="breadcrumb-item">
            <a href="{{ ('/' ~ folderName) | url }}" class="text-convrtr">{{ folderName }}</a>
        </li>
        {% endif %}
        {% endif %}
        {% if "changelog/" in page.inputPath %}
        <li class="breadcrumb-item">
            <a href="{{ '/changelog' | url }}" class="text-convrtr">changelog</a>
        </li>
        <li class="breadcrumb-item active" aria-current="page">
            v{{ page.fileSlug }}
        </li>
        {% elif "/tag/" in page.url %}
        <li class="breadcrumb-item">
            <a href="{{ '/changelog' | url }}" class="text-convrtr">changelog</a>
        </li>
        {%- set tag = page.url.split('/').slice(-2)[0] -%}
        <li class="breadcrumb-item active" aria-current="page">
            {{ tag }}
        </li>
        {% else %}
        <li class="breadcrumb-item active" aria-current="page">
            {{ pageId | lower }}
        </li>
        {% endif %}
    </ol>
</nav>
{% endif %}