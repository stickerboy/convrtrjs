{#- TermsFeed's cookie banner. Deferred, so it doesn't hold up the page; deferred scripts still run before
    DOMContentLoaded, so cookieconsent is ready when the banner starts. The palette follows the site theme, which the
    script in <head> has already resolved to light or dark. Accepting tracking runs the Google tag (ga.njk). #}
<script src="https://www.termsfeed.com/public/cookie-consent/4.2.0/cookie-consent.js" charset="UTF-8" defer></script>
<script>
    document.addEventListener("DOMContentLoaded", function () {
        cookieconsent.run({
            "notice_banner_type": "headline",
            "consent_type": "express",
            "palette": document.documentElement.getAttribute("data-bs-theme") === "dark" ? "dark" : "light",
            "language": "en",
            "page_load_consent_levels": ["strictly-necessary"],
            "notice_banner_reject_button_hide": false,
            "preferences_center_close_button_hide": false,
            "page_refresh_confirmation_buttons": false,
            "website_name": "{{ pkg.sitename }}",
            "website_privacy_policy_url": "{{ pkg.homepage }}/community/privacy",
            "notice_banner_purposes_levels": ["strictly-necessary", "functionality", "tracking"]
        });
    });
</script>
