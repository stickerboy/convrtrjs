<section class="section" id="IOOBI9O4IEIEOIO4O4IB">
    <div class="py-3 pb-4 px-2 px-sm-4">
        {% include "partials/breadcrumbs.njk" %}
        <div class="section-heading">
            {% set currentTag = tagPage.tag %}
            {% if not currentTag and "/changelog/tag/" in page.url %}
            {% set currentTag = page.url.replace("/changelog/tag/", "").split("/")[0] %}
            {% endif %}
            {% set currentTagLabel = labels.labels | where("key", currentTag | lower | trim) | first %}
            <h1 class="display-6">{%- if pageId == "changelog-item" -%}<span class="visually-hidden" data-pagefind-ignore>Changelog | </span>v{% endif %}{{ title }}{% if currentTag %} <span class="h5"><span class="badge git-badge badge-{% if currentTagLabel %}{{ currentTagLabel.key }}{% else %}{{ currentTag }}{% endif %}">{% if currentTagLabel %}{{ currentTagLabel.key }}{% else %}{{ currentTag }}{% endif %}</span></span>{% if tagPage.pagination.pageNumber > 0 %}<small class="text-body-secondary fs-3"> | Page {{ tagPage.pagination.pageNumber + 1 }}</small>{% endif %}{% endif %}{% if "changelog" in page.inputPath %}<small class="text-body-secondary fs-3">{{ changelogTitle }}</small>{% endif %}</h1>
            <hr>
            {#- Tool pages have no description: their summary is in the tool section #}
            {%- if description %}
            <p class="px-2"{%- if "changelog" in page.inputPath -%} data-pagefind-ignore="all"{%- endif -%}>
                {{ description }}
            </p>
            {%- endif %}
            {%- if tags %}
            {#- Left out of search, which has the labels as filters and shows them on each result #}
            <div class="px-2" data-pagefind-ignore="all">
                {%- for tag in tags -%}
                {% set label = labels.labels | where("key", tag | lower) | first -%}
                {% if label %}
                <a href="{{ '/changelog/tag/' ~ tag }}" class="badge git-badge badge-{{ label.key }}" title="{{ label.description }}">{{ label.key }}</a>
                {%- endif -%}
                {%- endfor %}
            </div>
            {%- endif -%}
        </div>
    </div>
</section>
