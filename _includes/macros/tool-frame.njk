{#
    The frame a text tool sits in. assets/js/ui/tool-frame.js wires it up.

    {% from "macros/tool-frame.njk" import toolFrame %}
    {% call toolFrame(filename, "Vigenère cipher", placeholder = "Example: Hello", actions = [{ id: filename + "Encrypt", label: "Encrypt" }]) %}
        …fields, as .tool-field…
    {% endcall %}

    The input with its result under it, and the caller's fields and the actions in a column beside them when the frame is
    wide enough. When it isn't, everything stacks in the order you use it: fields, input, actions, result. The result is
    plain text in a div, which only shows once there's something in it. Its header says what made it, and has "Move to
    input" to move it back into the input. Problems show under the input, as the result is hidden then.

    actions: the buttons that run the tool, as [{ id, label }]. With more than one, the first starts as the chosen mode.
    switchWithActions: the caller's content is a switch to show beside the buttons, for a tool with nothing else to set.
    tabs: names for several results to choose between, as tabs in place of the "Result" label (e.g. ["Text", "Binary",
    "Hex"]). The first is shown to start with; the tool's run returns a value for each.
    saveImage: a "Save as image" button and its transparent background switch under the result, as the glyph tools have
    under their glyphs (<id>Image, <id>Transparent); the tool's script draws the image.

    layout "list": the options in a bar above a full width input, with a scrolling list of results under it (the tool draws
    the list), labelled listLabel, for tools that make several results at once, such as the hash algorithms.
    layout "analysis": as "list", for tools that count or measure the input: the results (drawn by ui/frequencies.js) are
    figures and tables, which scroll on their own. With actions, the input and its settings are laid out as above, and the
    results run the frame's full width under them.

    inputs: several input boxes in place of the one, as [{ label, placeholder }], for a tool that takes more than one
    text (e.g. Interleave's First and Second). The tool's run gets each box's text in order, then the fields'.
    swap: a Swap button between the first two inputs, trading their text.
    inputList: a list of input boxes that more can be added to and taken away from, as { label, min, max, add,
    placeholder } (e.g. { label: "String", min: 2, max: 10, add: "Add a string" }); it starts with min boxes, labelled
    "String 1", "String 2"…, and the tool's run gets every box's text in order. ui/input-list.js runs it.

    id prefixes every element id: <id>Text, <id>Results, <id>Status, <id>Live. name labels the panes for screen readers
    and names downloads.
#}

{#- "Save as image" and its transparent background switch, under what's saved, on the right #}
{% macro saveImageControls(id) %}
<div class="tool-save-image">
    <div class="form-check form-switch">
        <input class="form-check-input" type="checkbox" role="switch" id="{{ id }}Transparent">
        <label class="form-check-label" for="{{ id }}Transparent">Transparent background</label>
    </div>
    <button type="button" class="btn btn-light btn-icon-text" id="{{ id }}Image"><i class="bi bi-image" aria-hidden="true"></i>Save as image</button>
</div>
{% endmacro %}

{#-
    One of several input boxes (see toolFrame's inputs and inputList): its label and count above it, and a button to
    remove it for a list that can have boxes taken away. The first box is <id>Text, as a tool's only box is; the rest are
    <id>Text2, <id>Text3 and so on, and ui/input-list.js renumbers them as boxes come and go.
#}
{% macro inputBox(id, n, label, placeholder = "", removable = false) %}
<div class="tool-inputs__item" data-input-item>
    <div class="tool-inputs__head">
        <label class="tool-inputs__label" for="{{ id }}Text{{ n if n > 1 }}" data-input-label>{{ label }}</label>
        <span class="tool-inputs__count" data-count-box></span>
        {%- if removable %}
        <button type="button" class="btn btn-light tool-inputs__remove" data-input-remove aria-label="Remove {{ label | lower }}" title="Remove"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
        {%- endif %}
    </div>
    <textarea id="{{ id }}Text{{ n if n > 1 }}" class="form-control tool-pane__box" rows="2" placeholder="{{ placeholder }}" autocomplete="off" data-input-box aria-describedby="{{ id }}Status"></textarea>
</div>
{% endmacro %}

{% macro toolFrame(id, name, placeholder = "", layout = "workspace", listLabel = "Results", tabs = [], saveImage = false, actions = [], switchWithActions = false, inputs = [], swap = false, inputList = none) %}
{%- set hasResults = layout == "list" or layout == "analysis" %}
{%- set settings = caller() %}
{%- set inputPane %}
        {%- if inputs | length or inputList %}
        {#- Several input boxes, each passed to the tool's run in order: a set of them, or a list that boxes can be added to #}
        <div class="tool-pane">
            <div class="tool-pane__head">
                <span class="tool-pane__label" id="{{ id }}InputLabel">Input<span class="visually-hidden"> for the {{ name }}</span></span>
            </div>
            <div class="tool-inputs" role="group" aria-labelledby="{{ id }}InputLabel" data-input-list
                {%- if inputList %} data-label="{{ inputList.label }}" data-min="{{ inputList.min or 2 }}" data-max="{{ inputList.max or 10 }}"{% endif %}>
                {%- if inputList %}
                {%- for n in range(1, (inputList.min or 2) + 1) %}
                {{ inputBox(id, n, inputList.label + " " + n, inputList.placeholder, removable = true) }}
                {%- endfor %}
                {%- else %}
                {%- for box in inputs %}
                {{ inputBox(id, loop.index, box.label, box.placeholder) }}
                {%- if swap and loop.first %}
                <button type="button" class="btn btn-outline-convrtr btn-icon-text tool-inputs__swap" data-input-swap aria-label="Swap {{ inputs[0].label | lower }} and {{ inputs[1].label | lower }}"><i class="bi bi-arrow-down-up" aria-hidden="true"></i>Swap</button>
                {%- endif %}
                {%- endfor %}
                {%- endif %}
            </div>
            {%- if inputList %}
            <button type="button" class="btn btn-outline-convrtr btn-icon-text tool-inputs__add" data-input-add><i class="bi bi-plus-lg" aria-hidden="true"></i>{{ inputList.add or "Add another" }}</button>
            {%- endif %}
            <div class="tool-pane__status">
                <span id="{{ id }}InputStatus" role="status"></span>
                {%- if not hasResults %}
                <span id="{{ id }}Status" role="status"></span>
                {%- endif %}
            </div>
        </div>
        {%- else %}
        <div class="tool-pane">
            <div class="tool-pane__head">
                <label class="tool-pane__label" for="{{ id }}Text">Input<span class="visually-hidden"> for the {{ name }}</span></label>
            </div>
            <textarea id="{{ id }}Text" class="form-control tool-pane__box" rows="{{ 4 if hasResults else 6 }}" placeholder="{{ placeholder }}" autocomplete="off" data-input-box{% if not hasResults %} aria-describedby="{{ id }}Status"{% endif %}></textarea>
            <div class="tool-pane__status">
                <span id="{{ id }}InputStatus" role="status"></span>
                {%- if not hasResults %}
                <span id="{{ id }}Status" role="status"></span>
                {%- endif %}
                <span data-count-input></span>
            </div>
        </div>
        {%- endif %}
{%- endset %}
{%- set liveSwitch %}
        <div class="form-check form-switch tool-frame__live">
            <input class="form-check-input" type="checkbox" role="switch" id="{{ id }}Live" aria-describedby="{{ id }}LiveHint">
            <label class="form-check-label" for="{{ id }}Live">
                Live typing
                <small class="tool-frame__live-hint" id="{{ id }}LiveHint" data-live-hint></small>
            </label>
        </div>
{%- endset %}
<div class="tool-frame" data-tool-frame>
    {%- if actions | length %}
    <div class="tool-frame__work">
        {%- if not switchWithActions and (settings | trim) %}
        <div class="tool-frame__settings">
            {{ settings | safe }}
        </div>
        {%- endif %}
        {{ inputPane | safe }}
        <div class="tool-frame__actions">
            <div class="tool-frame__buttons">
                {%- for action in actions %}
                <button type="button" class="btn {{ 'btn-convrtr' if loop.first else 'btn-outline-convrtr' }}" id="{{ action.id }}"{% if actions | length > 1 %} aria-pressed="{{ 'true' if loop.first else 'false' }}"{% endif %}>{{ action.label }}</button>
                {%- endfor %}
                {%- if switchWithActions %}
                {{ settings | safe }}
                {%- endif %}
            </div>
            {{ liveSwitch | safe }}
        </div>
        {%- if not hasResults %}
        <div class="tool-pane tool-frame__result" data-download-name="{{ name }}">
            <div class="tool-pane__head">
                {%- if tabs | length %}
                <div class="tool-pane__tabs" role="tablist" aria-label="Result format" data-output-tabs>
                    {%- for tab in tabs %}
                    <button type="button" role="tab" id="{{ id }}Tab{{ tab }}" data-tab="{{ tab }}" aria-controls="{{ id }}Results"
                        aria-selected="{{ 'true' if loop.first else 'false' }}" tabindex="{{ '0' if loop.first else '-1' }}">{{ tab }}</button>
                    {%- endfor %}
                </div>
                {%- else %}
                <span class="tool-pane__label" id="{{ id }}ResultsLabel">Result<span class="visually-hidden"> from the {{ name }}</span></span>
                {%- endif %}
                <span class="tool-frame__result-flow" data-flow aria-hidden="true"></span>
                <div class="tool-pane__actions">
                    <button type="button" class="btn btn-md btn-light btn-icon-text" data-use-as-input><i class="bi bi-arrow-up" aria-hidden="true"></i>Move to input</button>
                    {% include "components/select-copy-dl.njk" %}
                </div>
            </div>
            <div id="{{ id }}Results" class="tool-pane__result data-to-copy active" tabindex="0"
                {%- if tabs | length %} role="tabpanel" aria-labelledby="{{ id }}Tab{{ tabs | first }}"{% else %} role="region" aria-labelledby="{{ id }}ResultsLabel"{% endif %}></div>
            <div class="tool-pane__status">
                <span data-count-output></span>
                {%- if saveImage %}{{ saveImageControls(id) }}{% endif %}
            </div>
        </div>
        {%- endif %}
    </div>
    {%- else %}
    <div class="tool-frame__options">
        {{ settings | safe }}
        {{ liveSwitch | safe }}
    </div>
    {%- endif %}
    {%- if hasResults %}
    <div class="tool-frame__stack">
        {%- if not (actions | length) %}
        {{ inputPane | safe }}
        {%- endif %}
        <div class="tool-pane" data-download-name="{{ name }}">
            <div class="tool-pane__head">
                <span class="tool-pane__label" id="{{ id }}ResultsLabel">{{ listLabel }}</span>
                {% include "components/select-copy-dl.njk" %}
            </div>
            {#- A list scrolls as a whole, so it can be focused to scroll from the keyboard; an analysis's tables each do #}
            <div id="{{ id }}Results" class="{{ 'tool-pane__analysis' if layout == 'analysis' else 'tool-pane__list' }} data-to-copy active"
                {%- if layout == "list" %} tabindex="0"{% endif %} role="region" aria-labelledby="{{ id }}ResultsLabel" aria-describedby="{{ id }}Status"></div>
            <div class="tool-pane__status">
                <span id="{{ id }}Status" role="status"></span>
                <span data-count-output></span>
            </div>
        </div>
    </div>
    {%- endif %}
</div>
{% endmacro %}

{#
    The frame a file tool sits in: a drop zone (a label for the real file input, so it's one control from the keyboard
    and for screen readers), a line saying the file stays on the device, then the results with select, copy and
    download. assets/js/ui/file-drop.js wires it up.

    {% from "macros/tool-frame.njk" import fileFrame %}
    {% call fileFrame(filename, "Exif reader", formats = "JPEG, PNG or HEIC", privacy = "Read in your browser, never uploaded", accept = "image/*") %}{% endcall %}

    formats says what can be dropped; multiple lets several files be chosen at once. Element ids start with id: <id>Input,
    <id>Results, <id>Status.
#}
{% macro fileFrame(id, name, formats, privacy, accept = "", multiple = false) %}
<div class="tool-frame" data-tool-frame>
    <div class="tool-frame__stack">
        <div>
            <label class="tool-drop" data-drop>
                <input type="file" class="tool-drop__input" id="{{ id }}Input"{% if accept %} accept="{{ accept }}"{% endif %}{% if multiple %} multiple{% endif %} aria-describedby="{{ id }}Formats {{ id }}Privacy">
                <i class="bi bi-file-earmark-arrow-up tool-drop__icon" aria-hidden="true"></i>
                <span class="tool-drop__title" data-drop-title>{{ "Drop files here" if multiple else "Drop a file here" }}</span>
                <span class="tool-drop__formats" id="{{ id }}Formats">or <u>{{ "choose files" if multiple else "choose a file" }}</u> · {{ formats }}</span>
            </label>
            <p class="tool-drop__privacy" id="{{ id }}Privacy"><i class="bi bi-lock" aria-hidden="true"></i>{{ privacy }}</p>
        </div>
        {{ caller() if caller }}
        {#- Shown once there's a file to show results for #}
        <div class="tool-pane" data-download-name="{{ name }}" data-file-results hidden>
            <div class="tool-pane__head">
                <span class="tool-pane__label" id="{{ id }}ResultsLabel">Results</span>
                {% include "components/select-copy-dl.njk" %}
            </div>
            <div id="{{ id }}Results" class="tool-pane__analysis data-to-copy active" role="region" aria-labelledby="{{ id }}ResultsLabel" aria-describedby="{{ id }}Status"></div>
            <div class="tool-pane__status">
                <span id="{{ id }}Status" role="status"></span>
            </div>
        </div>
    </div>
</div>
{% endmacro %}

{#
    The frame a glyph tool sits in (Pigpen, Covenant, Forerunner): the message as text you can type in, a keyboard of
    glyphs under it that types their letters at the cursor, and the message's glyphs drawn as you type. assets/js/ui/glyph-keyboard.js wires it up.

    {% from "macros/tool-frame.njk" import glyphFrame %}
    {{ glyphFrame(filename, "Pigpen cipher", "'Pigpen Cipher'", "ABCDEFGHIJKLMNOPQRSTUVWXYZ".split("")) }}

    font is the glyph font, as CSS font-family; keys are the characters there are glyphs for, or {key, glyph} objects
    where the font draws a glyph from a different character than its letter (as Forerunner's does).
#}
{% macro glyphFrame(id, name, font, keys, placeholder = "Example: MEET AT THE OAK") %}
<div class="tool-frame glyph-frame" data-tool-frame data-glyph-keyboard style="--glyph-font: {{ font }}">
    <div class="tool-frame__stack">
        <div class="tool-pane" data-download-name="{{ name }}">
            <div class="tool-pane__head">
                <label class="tool-pane__label" for="{{ id }}Text">Message</label>
                {% include "components/select-copy-dl.njk" %}
            </div>
            <textarea id="{{ id }}Text" class="form-control tool-pane__box data-to-copy active" rows="3" placeholder="{{ placeholder }}"
                autocomplete="off" spellcheck="false" aria-describedby="{{ id }}Status"></textarea>
            <div class="tool-pane__status">
                <span id="{{ id }}Status" role="status"></span>
                <span data-count-input></span>
            </div>
        </div>
        <div>
            <p class="glyph-frame__hint" id="{{ id }}KeysHint">Type letters in the message, or tap glyphs to type their letters where the cursor is.</p>
            <div class="glyph-frame__keys" role="group" aria-label="{{ name }} glyphs" aria-describedby="{{ id }}KeysHint">
                {%- for item in keys %}
                {%- set key = item.key if item.key else item %}
                <button type="button" class="glyph-key" data-key="{{ key }}" data-glyph="{{ item.glyph if item.glyph else key }}" aria-label="{{ key }}">
                    <span class="glyph-key__glyph" aria-hidden="true">{{ item.glyph if item.glyph else key }}</span>
                    <span class="glyph-key__letter" aria-hidden="true">{{ key }}</span>
                </button>
                {%- endfor %}
            </div>
            <div class="glyph-frame__keybar">
                <button type="button" class="btn btn-light glyph-frame__space" data-key=" ">Space</button>
                <button type="button" class="btn btn-light btn-icon-text" data-backspace><i class="bi bi-backspace" aria-hidden="true"></i>Backspace</button>
                <button type="button" class="btn btn-light" data-clear>Clear</button>
            </div>
        </div>
        <div class="tool-pane">
            <div class="tool-pane__head">
                <span class="tool-pane__label">Glyphs</span>
            </div>
            {#- Drawn from the message, which screen readers already have #}
            <div class="glyph-frame__glyphs" id="{{ id }}Glyphs" aria-hidden="true" data-empty="The glyphs for your message appear here"></div>
            {{ saveImageControls(id) }}
        </div>
    </div>
</div>
{% endmacro %}
