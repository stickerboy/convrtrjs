{# Hex delimiter <select>, with id "<id>Delimiter" #}
{% macro delimiter(id) %}
<select class="form-select hex-delimiter" id="{{ id }}Delimiter" autocomplete="off" data-pagefind-ignore="all">
    <option value=" " selected="">Space</option>
    <option value="-">Hyphen</option>
    <option value=":">Colon</option>
    <option value=",">Comma</option>
    <option value="\x">Slash x </option>
    <option value="0x">Zero x</option>
    <option value="0x, ">Zero x with commas</option>
    <option value="%">Percent</option>
    <option value="">None</option>
</select>
{% endmacro %}
