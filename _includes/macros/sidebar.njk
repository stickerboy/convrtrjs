{#
    The site sidebar: a rail of categories and site links, and a panel listing the pages of the open category.
    currentUrl marks the current category and page. expanded is the category shown in the panel: the current one
    by default, or the first category on pages outside them (sitemap, settings...); "" closes the panel. The panel
    starts open on every page, and nav.js closes it for visitors who closed it. remember = false stops nav.js saving
    whether the panel is open, for pages that close it themselves. pagePanel is a page's own panel content, such as the
    search page's filters: it's shown in place of a category, and closing a category returns to it. Its title needs
    the id "<idPrefix>-page-title". idPrefix keeps ids unique when the sidebar is rendered more than once, as the UI
    kit does.
#}
{% macro categoryUrl(link) %}{{ "/" if link.id == "text" else "/" ~ link.id ~ "/" }}{% endmacro %}
{% macro pageUrl(link, child) %}{{ "/convrtrs/" if child.id == "convrtrs" else "/" ~ link.id ~ "/" ~ child.id ~ "/" }}{% endmacro %}

{% macro sidebar(nav, currentUrl, idPrefix = "sidebar", expanded = null, remember = true, pagePanel = "") %}
{%- set shown = nav | where("excludeFromSidebar", false) -%}
{%- set categories = shown | selectattr("children") -%}
{%- set links = shown | rejectattr("children") -%}
{#- The category containing the current page: its landing page, anything under its folder, or one of its pages -#}
{%- set currentId -%}
    {%- for link in categories -%}
        {%- set url = ("" ~ categoryUrl(link)) -%}
        {%- if currentUrl == url or (url != "/" and currentUrl.startsWith(url)) %}{{ link.id }}
        {%- else %}{% for child in link.children %}{% if ("" ~ pageUrl(link, child)) == currentUrl %}{{ link.id }}{% endif %}{% endfor %}
        {%- endif -%}
    {%- endfor -%}
{%- endset -%}
{%- set currentId = currentId | trim -%}
{%- set openId = (currentId or ("page" if pagePanel else (categories | first).id)) if expanded == null else expanded -%}
<nav class="sidebar" id="{{ idPrefix }}" aria-label="Site" data-panel="{{ 'open' if openId else 'closed' }}"{% if not remember %} data-remember="false"{% endif %}>
    <ul class="sidebar-rail">
        {%- for link in categories %}
        <li>
            <button type="button" class="sidebar-rail__item{% if link.id == currentId %} active{% endif %}"
                aria-expanded="{{ 'true' if link.id == openId else 'false' }}" aria-controls="{{ idPrefix }}-{{ link.id }}"
                data-category="{{ link.id }}">
                <i class="bi bi-{{ link.icon }}" aria-hidden="true"></i>
                <span class="sidebar-rail__label">{{ link.shortLabel }}</span>
            </button>
        </li>
        {%- endfor %}
        {%- for link in links %}
        {%- set url = "/" ~ link.id ~ "/" %}
        <li{% if loop.first %} class="sidebar-rail__end"{% endif %}>
            <a class="sidebar-rail__item" href="{{ url | url }}"{% if currentUrl.startsWith(url) %} aria-current="page"{% endif %}>
                <i class="bi bi-{{ link.icon }}" aria-hidden="true"></i>
                <span class="sidebar-rail__label">{{ link.shortLabel }}</span>
            </a>
        </li>
        {%- endfor %}
    </ul>
    <div class="sidebar-panel">
        {%- if pagePanel %}
        <div class="sidebar-panel__group" id="{{ idPrefix }}-page" role="region" aria-labelledby="{{ idPrefix }}-page-title" data-page-panel{% if openId != "page" %} hidden{% endif %}>
            {{ pagePanel | safe }}
        </div>
        {%- endif %}
        {%- for link in categories %}
        <div class="sidebar-panel__group" id="{{ idPrefix }}-{{ link.id }}" role="region" aria-labelledby="{{ idPrefix }}-{{ link.id }}-title"{% if link.id != openId %} hidden{% endif %}>
            <h2 class="sidebar-panel__title" id="{{ idPrefix }}-{{ link.id }}-title">
                <a href="{{ ("" ~ categoryUrl(link)) | url }}"{% if currentUrl == ("" ~ categoryUrl(link)) %} aria-current="page"{% endif %}>{{ link.label }}</a>
            </h2>
            <p class="sidebar-panel__count">{{ link.children | length }} {{ "pages" if link.id == "community" else "tools" }}</p>
            <ul class="sidebar-panel__list">
                {%- for child in link.children | sort(false, true, "id") %}
                {%- set url = ("" ~ pageUrl(link, child)) %}
                <li><a class="sidebar-panel__link" href="{{ url | url }}"{% if url == currentUrl %} aria-current="page"{% endif %}>{{ child.label }}</a></li>
                {%- endfor %}
            </ul>
        </div>
        {%- endfor %}
    </div>
</nav>
{% endmacro %}
