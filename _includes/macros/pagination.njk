{# Numbered page links for an Eleventy pagination object (or one shaped like it, e.g. tagPage.pagination) #}
{% macro paginationNav(pagination) %}
{% if pagination.pages | length > 1 %}
<nav class="px-2" aria-label="{{ pagination.label}}" data-pagefind-ignore="all">
    <ul class="pagination">
    <!-- Previous Link -->
    {% if pagination.previousPageHref %}
        <li class="page-item">
            <a href="{{ pagination.previousPageHref }}" class="page-link">
                <span class="d-none d-sm-block">Previous</span>
                <span class="d-block d-sm-none" aria-label="Previous">&#8678;</span>
            </a>
        </li>
        <li class="page-item">
            <a class="page-link" href="{{ pagination.href.first }}" aria-label="Jump to first page">
                <span aria-hidden="true">&laquo;</span>
            </a>
        </li>
    {% else %}
        <li class="page-item disabled">
            <span class="page-link d-none d-sm-block">Previous</span>
            <span class="page-link d-block d-sm-none" aria-label="Previous">&#8678;</span>
        </li>
    {% endif %}

    <!-- Page Number Links -->
    {% set currentPage = pagination.pageNumber %}
    {% set startPage = currentPage - 1 %}
    {% set endPage = currentPage + 2 %}
    {% for pageNumber in pagination.pages %}
        {% set pageIndex = loop.index0 %}
        {% if pageIndex >= startPage and pageIndex <= endPage -%}
        <li class="page-item {% if pageIndex == currentPage %}active{% endif %}">
        {% if pageIndex == currentPage %}
            <span class="page-link">{{ pageIndex + 1 }}</span>
        {% else %}
            <a href="{{ pagination.hrefs[pageIndex] }}" class="page-link">{{ pageIndex + 1 }}</a>
        {% endif %}
        </li>
        {% endif %}
    {% endfor %}

    <!-- Next Link -->
    {% if pagination.nextPageHref %}
        <li class="page-item">
            <a class="page-link" href="{{ pagination.href.last }}" aria-label=" Jump to last page">
                <span aria-hidden="true">&raquo;</span>
            </a>
        </li>
        <li class="page-item">
            <a href="{{ pagination.nextPageHref }}" class="page-link">
                <span class="d-none d-sm-block">Next</span>
                <span class="d-block d-sm-none" aria-label="Next">&#8680;</span>
            </a>
        </li>
    {% else %}
        <li class="page-item disabled">
            <span class="page-link d-none d-sm-block">Next</span>
            <span class="page-link d-block d-sm-none" aria-label="Next">&#8680;</span>
        </li>
    {% endif %}
    </ul>
</nav>
{% endif %}
{% endmacro %}
