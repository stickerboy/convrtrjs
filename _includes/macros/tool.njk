{#
    Collapsible tool section: heading, the tool's one-line summary, its intro folded under "More about this tool", then
    the tool UI in a collapse body. The collapse toggle only shows on category landing pages (.landing-page, set by the
    base layout).

    {% from "macros/tool.njk" import toolSection with context %}
    {% set intro %}<p>Examples, links and credits…</p>{% endset %}
    {% call toolSection(intro) %}
        …tool UI…
    {% endcall %}

    Uses page data: summary (one sentence, which may hold inline HTML; also the page's meta description), heading (falls
    back to title), page.fileSlug as the section id, noScript: true to skip loading the tool's JS module, and noLimits: true
    to leave the data limits note out of the fold, for tools that don't take typed text.
#}
{% macro toolSection(intro = "") %}
{%- set id = page.fileSlug -%}
{#- Saved by its folder and id, such as "hex/frequencies", as two categories can have a tool with the same id #}
<section id="{{ id }}" class="section" data-section-key="{{ page.filePathStem | replace("/pages/", "") }}">
    <div class="section-heading">
        <a class="section-toggle justify-content-between text-decoration-none pt-4 pb-3 px-2 px-sm-4"
            data-bs-toggle="collapse" href="#{{ id }}Collapse" role="button"
            aria-expanded="true" aria-controls="{{ id }}Collapse"
            data-section-name="{{ heading or title }}"
            data-pagefind-ignore="all">
            <h2 class="display-6 w-100 d-flex m-0">
                {{ heading or title }}
            </h2>
            <span class="text-light px-1 border rounded align-self-end toggle-button" data-bs-toggle="tooltip" data-bs-placement="left" data-bs-original-title="Collapse section">
                <i class="bi bi-arrow-up lh-base"></i>
            </span>
        </a>
        <hr class="section-toggle-rule my-0 mx-4">
        <div class="section-description py-3 px-2 px-sm-4">
            <p class="tool-summary">{{ summary | safe }}</p>
            {%- if intro | trim or not noLimits %}
            <details class="tool-about">
                <summary><i class="bi bi-chevron-right tool-about__chevron" aria-hidden="true"></i>More about this tool<span class="visually-hidden">: {{ heading or title }}</span></summary>
                <div class="tool-about__body">
                    {{ intro }}
                    {%- if not noLimits %}
                    {% include "components/data-limits.njk" %}
                    {%- endif %}
                </div>
            </details>
            {%- endif %}
        </div>
    </div>
    <div class="pb-4 px-2 px-sm-4 collapse show" id="{{ id }}Collapse">
        {{ caller() }}
    </div>
</section>
{%- if not noScript %}
{% include "components/dynamic-script.njk" %}
{%- endif %}
{% endmacro %}
