---
title: Search
description: Quickly search and filter through the available decoding tools, and resources
permalink: /search/
# The filters sit in the sidebar panel: partials/panels/search.njk
sidebarPanel: search
eleventyComputed:
  description: "{{ description }}<br />A minimum of 2 characters is required in order for results to be returned"
---

{% set filename = page.fileSlug %}
<section id="{{ filename }}" class="section py-4 px-3 px-sm-4">
    <div id="page-search" class="col-md-12 text-center search">
      <pagefind-config excerpt-length="80"></pagefind-config>
      <pagefind-input debounce="500"></pagefind-input>
      <div class="mt-3 text-start">
          <button type="button" class="btn btn-outline-convrtr btn-sm d-md-none mb-3" data-sidebar-page-panel aria-controls="sidebar-page">
            <i class="bi bi-funnel" aria-hidden="true"></i> Filters
          </button>
          <div>
            <convrtr-summary></convrtr-summary>
            <div class="mt-3 list-group">
              <pagefind-results></pagefind-results>
              <script>
                (() => {
                  // the html-template context strips "filters", so a JS resultTemplate is required to render tags
                  const escapeHtml = (str) => String(str ?? "").replace(/[&<>"']/g, (c) => ({
                    "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;"
                  }[c]));

                  const resultsEl = document.currentScript.previousElementSibling;

                  // element resets resultTemplate on upgrade, so it must be set after the custom element is defined
                  customElements.whenDefined("pagefind-results").then(() => {
                    resultsEl.resultTemplate = (data) => {
                      const tags = [...new Set([...(data.filters?.Release ?? []), ...(data.filters?.Changes ?? [])])];
                      const tagsHtml = tags.length
                        ? `<div class="badges mt-3">${tags.map((tag) => `<span class="badge badge-${escapeHtml(tag)}">${escapeHtml(tag)}</span>`).join("")}</div>`
                        : "";

                      return `
                        <li class="pf-result-item list-group-action-item">
                          <p class="pf-result-title mb-3">
                            <a href="${escapeHtml(data.url)}" class="pf-result-link">${escapeHtml(data.meta?.title)}</a>
                          </p>
                          <p class="result-excerpt">${data.excerpt ?? ""}</p>
                          ${tagsHtml}
                        </li>
                      `;
                    };
                  });
                })();
              </script>
            </div>
      </div>
    </div>
</section>
<script type="module" src="/assets/js/site/search.js"></script>
