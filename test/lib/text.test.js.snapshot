exports[`replace and frequencies (toolkit) > renders frequency HTML as before 1`] = `
"\\n        <div class=\\"g-col-12\\">\\n            <p class=\\"display-5 fs-5 mt-4\\">Unique characters</p>\\n            <div class=\\"grid mt-2 grid-auto\\" id=\\"unique-chars\\">\\n                <code tabindex=\\"0\\" class=\\"d-inline-flex px-2 bg-success bg-opacity-10 border border-success border-opacity-10 rounded-2 me-2\\" style=\\"width: max-content;\\" title=\\"a\\" role=\\"note\\">\\n                    a\\n                </code><code tabindex=\\"0\\" class=\\"d-inline-flex px-2 bg-success bg-opacity-10 border border-success border-opacity-10 rounded-2 me-2\\" style=\\"width: max-content;\\" title=\\"b\\" role=\\"note\\">\\n                    b\\n                </code><code tabindex=\\"0\\" class=\\"d-inline-flex px-2 bg-success bg-opacity-10 border border-success border-opacity-10 rounded-2 me-2\\" style=\\"width: max-content;\\" title=\\"Space\\" role=\\"note\\">\\n                    &nbsp;\\n                </code><code tabindex=\\"0\\" class=\\"d-inline-flex px-2 bg-success bg-opacity-10 border border-success border-opacity-10 rounded-2 me-2\\" style=\\"width: max-content;\\" title=\\"c\\" role=\\"note\\">\\n                    c\\n                </code>\\n            </div>\\n        </div>"
`;

exports[`replace and frequencies (toolkit) > renders frequency HTML as before 2`] = `
"\\n        <div class=\\"g-col-12\\">\\n            <p class=\\"display-5 fs-5 mt-4\\">Test</p>\\n            <div class=\\"grid grid--fill mt-2\\" style=\\"--bs-column-fill: 6rem\\">\\n                <div>\\n                    <code tabindex=\\"0\\" class=\\"w-auto d-inline-flex px-2 bg-success bg-opacity-10 border border-success border-opacity-10 rounded-2 me-2\\" style=\\"width: max-content;\\" title=\\"Frequency of a\\" role=\\"note\\">\\n                        a - 2\\n                    </code>\\n                </div><div>\\n                    <code tabindex=\\"0\\" class=\\"w-auto d-inline-flex px-2 bg-success bg-opacity-10 border border-success border-opacity-10 rounded-2 me-2\\" style=\\"width: max-content;\\" title=\\"Frequency of b\\" role=\\"note\\">\\n                        b - 1\\n                    </code>\\n                </div>\\n            </div>\\n        </div>"
`;
